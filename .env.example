# Copy to .env and fill in. Never commit .env.

# IBM watsonx.ai
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_LLM_MODEL=ibm/granite-3-3-8b-instruct
WATSONX_EMBED_MODEL=ibm/slate-125m-english-rtrvr-v2

# Provider selection: auto | watsonx | ollama | local
#   auto  = watsonx if credentials are set, else local (offline)
LLM_PROVIDER=auto
EMBED_PROVIDER=auto

# Vector store: auto | chroma | simple   (simple = pure numpy, for s390x)
VECTOR_BACKEND=auto

# Optional local Ollama server
OLLAMA_URL=http://localhost:11434
OLLAMA_LLM_MODEL=granite3.3:8b
OLLAMA_EMBED_MODEL=granite-embedding:278m

TOP_K=5
CHUNK_SIZE=700
CHUNK_OVERLAP=100
